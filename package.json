{
  "name": "typed-css-modules-next",
  "version": "1.0.0",
  "description": "Creates TypeScript declaration files for CSS Modules",
  "keywords": [
    "css-modules",
    "typescript"
  ],
  "homepage": "https://github.com/baevm/typed-css-modules-next#readme",
  "bugs": {
    "url": "https://github.com/baevm/typed-css-modules-next/issues"
  },
  "license": "MIT",
  "author": "Mikhail Baev",
  "contributors": [
    "Yosuke Kurami and typed-css-modules contributors"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baevm/typed-css-modules-next.git"
  },
  "bin": {
    "tcm": "lib/cli.js",
    "tcm-next": "lib/cli.js"
  },
  "files": [
    "lib",
    "LICENSE.txt",
    "PUBLISHING.md",
    "README.md"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && chmod +x lib/cli.js",
    "oxfmt": "oxfmt",
    "format": "npm run oxfmt",
    "lint": "npm run oxfmt -- --check",
    "compile": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage",
    "check": "npm run lint && npm run compile && npm test -- --runInBand",
    "prepack": "npm run build"
  },
  "dependencies": {
    "camelcase": "^6.0.0",
    "chalk": "^4.0.0",
    "chokidar": "^3.4.0",
    "glob": "^10.3.10",
    "icss-replace-symbols": "^1.1.0",
    "is-there": "^4.4.2",
    "mkdirp": "^3.0.0",
    "postcss": "^8.0.0",
    "postcss-modules-extract-imports": "^3.0.0",
    "postcss-modules-local-by-default": "^4.0.0",
    "postcss-modules-scope": "^3.0.0",
    "postcss-modules-values": "^4.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/yargs": "17.0.35",
    "jest": "29.7.0",
    "oxfmt": "0.65.0",
    "ts-jest": "29.4.11",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
